@page "/"
@using uttt.app.Shared
@using uttt.game

<div class="only-board">
    <UttBoard NextPlayerChanged="OnNextPlayerChanged" />
</div>

@code {
    private string nextPlayerText = "X";

    private void OnNextPlayerChanged(Player p)
    {
        nextPlayerText = p == Player.One ? "X" : "O";
        StateHasChanged();
    }
}
